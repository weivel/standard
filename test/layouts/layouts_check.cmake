# -DLAYOUTS=<layouts executable> -DCHECK=<fit|complete> [-DHEADERS=<directory of public headers>]
#
# fit: every field ends within its struct's sizeof, and every struct with fields has a sizeof line.
# complete: every struct a public header declares with a body has a sizeof line, and no other struct has one, so a
# struct added to a header without a layout line fails here.

cmake_minimum_required(VERSION 3.15)

execute_process(COMMAND ${LAYOUTS} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT code STREQUAL "0")
    message(FATAL_ERROR "${LAYOUTS} exited ${code}\n${errors}")
endif()
string(REPLACE "\r" "" output "${output}")
string(REPLACE "\n" ";" lines "${output}")
list(FILTER lines EXCLUDE REGEX "^$")
list(LENGTH lines line_count)
if(line_count EQUAL 0)
    message(FATAL_ERROR "${LAYOUTS} printed no layout, so nothing was checked")
endif()

function(check_fit)
    set(offenders "")
    set(structs_with_size "")
    set(structs_with_fields "")
    foreach(line IN LISTS lines)
        string(REPLACE " " ";" parts "${line}")
        list(LENGTH parts count)
        if(count EQUAL 3)
            list(GET parts 0 struct)
            list(GET parts 1 word)
            list(GET parts 2 size)
            if(NOT word STREQUAL "sizeof")
                list(APPEND offenders "malformed line '${line}'")
            endif()
            if(DEFINED end_of_${struct} AND end_of_${struct} GREATER size)
                list(APPEND offenders "${struct}: a field ends at ${end_of_${struct}}, past its sizeof ${size}")
            endif()
            list(APPEND structs_with_size "${struct}")
        elseif(count EQUAL 4)
            list(GET parts 0 struct)
            list(GET parts 2 offset)
            list(GET parts 3 size)
            math(EXPR end "${offset} + ${size}")
            if(NOT DEFINED end_of_${struct} OR end GREATER end_of_${struct})
                set(end_of_${struct} ${end})
            endif()
            list(APPEND structs_with_fields "${struct}")
        else()
            list(APPEND offenders "malformed line '${line}'")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES structs_with_fields)
    foreach(struct IN LISTS structs_with_fields)
        if(NOT struct IN_LIST structs_with_size)
            list(APPEND offenders "${struct}: fields but no sizeof line")
        endif()
    endforeach()
    if(offenders)
        string(REPLACE ";" "\n" report "${offenders}")
        message(FATAL_ERROR "${report}")
    endif()
    list(LENGTH structs_with_size struct_count)
    message(STATUS "${struct_count} structs, every field within its sizeof")
endfunction()

function(check_complete)
    file(GLOB_RECURSE headers "${HEADERS}/*.h")
    set(declared "")
    foreach(header IN LISTS headers)
        file(READ "${header}" content)
        string(REGEX MATCHALL "typedef[ \t\r\n]+(struct|union)[ \t\r\n]+weivel_[a-z0-9_]+[ \t\r\n]*{" found "${content}")
        foreach(declaration IN LISTS found)
            string(REGEX REPLACE ".*(weivel_[a-z0-9_]+).*" "\\1" name "${declaration}")
            list(APPEND declared "${name}")
        endforeach()
    endforeach()
    list(LENGTH declared declared_count)
    if(declared_count EQUAL 0)
        message(FATAL_ERROR "no struct declared under ${HEADERS}, so nothing was checked")
    endif()
    set(printed "")
    foreach(line IN LISTS lines)
        if(line MATCHES "^([^ ]+) sizeof [0-9]+$")
            list(APPEND printed "${CMAKE_MATCH_1}")
        endif()
    endforeach()
    set(offenders "")
    foreach(name IN LISTS declared)
        if(NOT name IN_LIST printed)
            list(APPEND offenders "${name} is declared under ${HEADERS} and has no layout")
        endif()
    endforeach()
    foreach(name IN LISTS printed)
        if(NOT name IN_LIST declared)
            list(APPEND offenders "${name} has a layout and is declared by no public header")
        endif()
    endforeach()
    if(offenders)
        string(REPLACE ";" "\n" report "${offenders}")
        message(FATAL_ERROR "${report}")
    endif()
    message(STATUS "${declared_count} public structs, each with a layout")
endfunction()

if(CHECK STREQUAL "fit")
    check_fit()
elseif(CHECK STREQUAL "complete")
    check_complete()
else()
    message(FATAL_ERROR "unknown CHECK '${CHECK}': use fit or complete")
endif()
